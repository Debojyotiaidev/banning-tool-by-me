# AI provider: ollama (default, local LLM via Ollama HTTP API) |
#              local (offline deterministic rules engine) | gemini
AI_PROVIDER=ollama

# Ollama server settings (only used when AI_PROVIDER=ollama).
# No paid API key required -- Ollama runs on your own machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# Seconds to wait for an Ollama response before giving up.
OLLAMA_TIMEOUT=120

# Only required when AI_PROVIDER=gemini (pip install .[gemini])
GOOGLE_API_KEY=

# Optional Instagram login (only used to read public profile data; leave blank
# to stay fully anonymous when possible)
INSTAGRAM_USER=
INSTAGRAM_PASSWORD=

# Server binding
HOST=127.0.0.1
PORT=8000
DEBUG=True

