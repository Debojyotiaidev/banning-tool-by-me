# AI provider: ollama (default, local LLM via Ollama HTTP API) |
#              local (offline deterministic rules engine) | gemini
AI_PROVIDER=ollama

# Ollama server settings (only used when AI_PROVIDER=ollama).
# No paid API key required -- Ollama runs on your own machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default model is llama3.2:3b -- a lightweight model that fits an 8 GB RAM
# machine. Install it once with:  ollama pull llama3.2:3b
# On 16 GB+ machines you can switch to a larger model (e.g. llama3.1:8b).
OLLAMA_MODEL=llama3.2:3b
# Seconds to wait for an Ollama response before giving up.
OLLAMA_TIMEOUT=120

# Server binding
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Set to 1 to prevent the CLI from auto-opening a browser tab on startup.
SONICS_NO_BROWSER=0

