# AI provider: local (default, offline rules engine) | gemini | ml
AI_PROVIDER=local

# Only required when AI_PROVIDER=gemini (pip install .[gemini])
GOOGLE_API_KEY=

# Optional Instagram login (only used to read public profile data; leave blank
# to stay fully anonymous when possible)
INSTAGRAM_USER=
INSTAGRAM_PASSWORD=

# Server binding
HOST=127.0.0.1
PORT=8000
DEBUG=True

